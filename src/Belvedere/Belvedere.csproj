<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Belvedere</AssemblyName>
    <RootNamespace>Belvedere</RootNamespace>
    <Product>Belvedere</Product>
    <Company>Belvedere (revived)</Company>
    <Version>2.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>resources\belvedere.ico</ApplicationIcon>

    <!-- A single window app that lives in the tray; keep the console hidden. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Bundle the legacy icons so the tray/app can reuse them. -->
  <ItemGroup>
    <None Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
